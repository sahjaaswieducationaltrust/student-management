# Keep the build context small and make sure no local secret or prebuilt
# artefact leaks into the image — the Dockerfile builds everything from source.

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]

node_modules/
frontend/dist/
.vite/

# Secrets stay in the host's environment variables, never in the image.
.env
*/.env
backend/.env

# Prebuilt static output — stage 1 regenerates this.
backend/static/
backend/tests/_output/

*.zip
.azure/
.vscode/
.idea/
.DS_Store
Thumbs.db
README.md
*.ps1
