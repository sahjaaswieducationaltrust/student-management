# Optional. In development the Vite dev server proxies /api to the backend,
# so you normally do not need any of these.

# Where the Vite dev-server proxy forwards /api requests:
VITE_API_TARGET=http://127.0.0.1:8000

# Only for a production build served from a different origin than the API.
# Leave unset to use same-origin relative /api calls.
# VITE_API_URL=https://api.your-school.com
