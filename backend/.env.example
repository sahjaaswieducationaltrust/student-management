# Copy to backend/.env and adjust.

# --- database ---
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (URL-encode special characters in the password: p@ss -> p%40ss):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=preschool

# --- auth (CHANGE THE SECRET BEFORE GOING LIVE) ---
JWT_SECRET=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- first admin account, created automatically on first start ---
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# --- school profile (printed on every fee receipt) ---
# Hello Kids is a franchise — put YOUR branch's details here, not the franchise
# head office. These print on every receipt a parent receives.
SCHOOL_NAME=Hello Kids Preschool
SCHOOL_BRANCH=Bells
# The legal entity running the branch — printed under the school name on every
# receipt and shown in the app header.
SCHOOL_TRUST=Sahjaswi Educational Trust
SCHOOL_TAGLINE=The Power of Early Childhood Education
SCHOOL_ADDRESS=<< your branch address >>
SCHOOL_PHONE=<< your branch phone >>
SCHOOL_EMAIL=<< your branch email >>
SCHOOL_WEBSITE=www.hellokids.co.in
# Logo file inside backend/app/assets/ — replace to use your own artwork.
SCHOOL_LOGO=hellokids-logo.png
CURRENCY_SYMBOL=₹

# --- academics ---
ACADEMIC_YEAR=2026-27
SESSION_START_MONTH=4

# --- registers ---
# Prefix for generated admission numbers: HKB20260002 for Hello Kids Bells.
# Changing this affects new admissions only. To re-prefix numbers already
# issued, run backend/scripts/renumber_admissions.py.
ADMISSION_PREFIX=HKB
EMPLOYEE_PREFIX=EMP

# --- messaging parents (MSG91) ---
# Left off, the Message Parents page prepares WhatsApp click-to-chat links,
# which cost nothing and need no approval. Automated sending needs an MSG91
# account, DLT registration for the trust and Meta-approved templates first —
# see DEPLOY.md. It fails closed: half-configured means manual mode, never a
# silent no-op that reports success.
MESSAGING_ENABLED=false
# Even when enabled this stops anything actually being sent; it logs what it
# would have done. Leave true until you have seen a dry run you are happy with.
MESSAGING_DRY_RUN=true
PHONE_COUNTRY_CODE=91
# MSG91_AUTH_KEY=
# MSG91_WHATSAPP_NUMBER=917760022267
# MSG91_SMS_SENDER_ID=HKBELL
# MSG91_SMS_FLOW_ID=
# MSG91_WHATSAPP_TEMPLATE=school_announcement

# --- frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
